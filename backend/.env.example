# PulseIQ Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# App
ENVIRONMENT=development
DEBUG=true

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pulseiq

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI (store real key in AWS Secrets Manager in production)
OPENAI_API_KEY=

# ElastiCache / Redis
ELASTICACHE_URL=redis://localhost:6379/0

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=pulseiq-exports

# Web Push (VAPID)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=push@pulseiq.io
